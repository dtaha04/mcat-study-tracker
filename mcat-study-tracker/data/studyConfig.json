  "shared": {
    "enabled": true,

    "activities": [
      "CARS",
      "Full Length",
      "Full Length Review",
      "Weakness Review",
      "Study Session"
    ],

    "full_length_rules": {
      "same_day_optional": true,
      "realistic_conditions": true,
      "next_day_deep_review": true
    }
  },

  "overflow": {
    "enabled": true,

    "statuses": {
      "scheduled": "Normal scheduled task",
      "overdue": "Task was missed on its original date",
      "carried": "Task has been moved into a later study day",
      "completed": "Task completed"
    },

    "calendar": {
      "complete": "green",
      "today": "blue",
      "incomplete": "red",
      "completed_late": "yellow",
      "future": "gray"
    },

    "rules": [
      "Incomplete tasks remain attached to their original scheduled date.",
      "Incomplete tasks appear on the next study day as overflow.",
      "Original missed days remain visibly flagged.",
      "Priority 1 overflow is completed before new lower-priority work.",
      "Overflow does not erase completion history.",
      "New low-priority work may be reduced when backlog becomes excessive.",
      "Full-length exam days are protected from normal overflow.",
      "MCAT day never receives overflow."
    ]
  }
