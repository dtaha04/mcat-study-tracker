{
  "version": 2,
  "exam": {
    "date": "2027-01-21",
    "name": "MCAT",
    "target_score": 512
  },

  "global_rules": {
    "normal_daily_hours_min": 5,
    "normal_daily_hours_max": 6,
    "light_day_hours": 3,
    "light_day_frequency_days": 7,
    "overflow_enabled": true,
    "overflow_priority": true,
    "overflow_warning_minutes": 120,
    "overflow_critical_minutes": 240,
    "protect_full_length_days": true,
    "protect_exam_day": true
  },

  "diya": {
    "display_name": "Diya",
    "track": "questions",
    "target_score": 512,

    "rules": {
      "content_strategy": "targeted_repair_only",
      "passive_content_review": false,
      "review_incorrect": true,
      "review_guessed_correct": true,
      "review_uncertain_correct": true,
      "daily_anki": true,
      "daily_cars": true
    },

    "phases": [
      {
        "id": "kaplan_transition",
        "name": "Kaplan Mixed Practice",
        "start": "2026-10-03",
        "end": "2026-10-11",
        "primary_resource": "Kaplan QBank",
        "question_target_min": 50,
        "question_target_max": 60,
        "cars_passages_min": 2,
        "cars_passages_max": 3,
        "anki_minutes": 45,
        "targeted_repair_minutes": 45,
        "review_minutes": 150,
        "notes": "Use mixed section practice. Questions diagnose weaknesses. Do not perform broad passive content review."
      },

      {
        "id": "uworld_build",
        "name": "UWorld Build",
        "start": "2026-10-12",
        "end": "2026-11-15",
        "primary_resource": "UWorld",
        "secondary_resource": "Kaplan QBank",
        "question_target_min": 60,
        "question_target_max": 70,
        "cars_passages_min": 2,
        "cars_passages_max": 3,
        "anki_minutes": 45,
        "targeted_repair_minutes": 45,
        "review_minutes": 180,
        "notes": "UWorld becomes the primary science and P/S learning tool. Review every incorrect, guessed, or uncertain question."
      },

      {
        "id": "uworld_intensive",
        "name": "UWorld Intensive",
        "start": "2026-11-16",
        "end": "2026-12-13",
        "primary_resource": "UWorld",
        "secondary_resource": "AAMC",
        "question_target_min": 70,
        "question_target_max": 80,
        "cars_passages_min": 3,
        "cars_passages_max": 4,
        "anki_minutes": 40,
        "targeted_repair_minutes": 40,
        "review_minutes": 180,
        "notes": "Increase mixed timed work. Begin integrating official AAMC material while continuing UWorld weaknesses."
      },

      {
        "id": "aamc_transition",
        "name": "AAMC Transition",
        "start": "2026-12-14",
        "end": "2026-12-27",
        "primary_resource": "AAMC",
        "secondary_resource": "UWorld",
        "question_target_min": 60,
        "question_target_max": 70,
        "cars_passages_min": 3,
        "cars_passages_max": 4,
        "anki_minutes": 35,
        "targeted_repair_minutes": 35,
        "review_minutes": 180,
        "notes": "Official AAMC reasoning becomes the priority. Use UWorld primarily for targeted weakness repair."
      },

      {
        "id": "aamc_intensive",
        "name": "AAMC Intensive",
        "start": "2026-12-28",
        "end": "2027-01-13",
        "primary_resource": "AAMC",
        "secondary_resource": "UWorld Targeted",
        "question_target_min": 60,
        "question_target_max": 80,
        "cars_passages_min": 3,
        "cars_passages_max": 5,
        "anki_minutes": 30,
        "targeted_repair_minutes": 30,
        "review_minutes": 180,
        "notes": "Prioritize Section Bank and other official AAMC material. Review reasoning deeply."
      },

      {
        "id": "final_taper",
        "name": "Final MCAT Taper",
        "start": "2027-01-14",
        "end": "2027-01-20",
        "primary_resource": "AAMC",
        "secondary_resource": "Error Log",
        "question_target_min": 30,
        "question_target_max": 50,
        "cars_passages_min": 2,
        "cars_passages_max": 3,
        "anki_minutes": 25,
        "targeted_repair_minutes": 30,
        "review_minutes": 120,
        "notes": "Reduce volume. Prioritize official reasoning, high-yield weaknesses, sleep, timing, and confidence. Do not cram."
      },

      {
        "id": "exam",
        "name": "MCAT DAY",
        "start": "2027-01-21",
        "end": "2027-01-21",
        "primary_resource": "MCAT",
        "question_target_min": 0,
        "question_target_max": 0,
        "cars_passages_min": 0,
        "cars_passages_max": 0,
        "anki_minutes": 0,
        "targeted_repair_minutes": 0,
        "review_minutes": 0,
        "notes": "MCAT DAY. No scheduled study workload."
      }
    ],

    "subject_rotation": [
      "B/B",
      "C/P",
      "P/S",
      "B/B",
      "C/P",
      "Mixed"
    ],

    "normal_day_template": [
      {
        "type": "Questions",
        "priority": 1,
        "label": "Primary timed question block"
      },
      {
        "type": "Review",
        "priority": 1,
        "label": "Deep review of misses, guesses and uncertain answers"
      },
      {
        "type": "CARS",
        "priority": 1,
        "label": "Timed CARS passages and review"
      },
      {
        "type": "Anki",
        "priority": 2,
        "label": "Due cards and cards created from meaningful misses"
      },
      {
        "type": "Content",
        "priority": 2,
        "label": "Targeted repair of weaknesses exposed by questions"
      }
    ],

    "light_day_template": [
      {
        "type": "Overflow",
        "priority": 1,
        "label": "Clear important carried work first"
      },
      {
        "type": "CARS",
        "priority": 1,
        "label": "2 timed CARS passages with review"
      },
      {
        "type": "Anki",
        "priority": 2,
        "label": "Due cards"
      },
      {
        "type": "Review",
        "priority": 2,
        "label": "Error log and weakness review"
      }
    ]
  },

